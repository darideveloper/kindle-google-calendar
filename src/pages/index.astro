---
import { getWeek, timeFmt } from '../lib/calendar';

Astro.response.headers.set('Cache-Control', 'no-cache');

const { configError, days, todayKey, stripRows, weekLabel, updatedTimeStr } = await getWeek();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Next 7 Days</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.35;
        color: #000;
        background: #fff;
        margin: 0 auto;
        padding: 16px;
      }
      h1 {
        font-size: 20px;
        margin: 0 0 8px;
      }
      h2 {
        font-size: 16px;
        margin: 16px 0 4px;
        padding-bottom: 2px;
        border-bottom: 1px solid #ccc;
      }
      h2.today {
        font-weight: bold;
      }
      p.free {
        color: #888;
        margin: 2px 0 0;
      }
      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      li.event {
        border-left: 3px solid #000;
        padding: 2px 0 2px 8px;
        margin: 4px 0;
      }
      .time {
        display: inline-block;
        min-width: 52px;
        color: #555;
      }
      .allday {
        display: inline-block;
        min-width: 52px;
        white-space: nowrap;
        color: #555;
        font-weight: bold;
      }
      .title {
        font-weight: bold;
      }
      .cal {
        display: block;
        font-size: 13px;
        color: #888;
      }
      section.strip {
        margin-top: 16px;
      }
      section.strip .dayrow {
        white-space: nowrap;
      }
      section.strip .daycol {
        display: inline-block;
        vertical-align: top;
        width: 33.33%;
        box-sizing: border-box;
        padding-right: 12px;
        white-space: normal;
      }
      section.strip h2 {
        font-size: 14px;
        margin: 0 0 4px;
        padding-bottom: 2px;
        border-bottom: 1px solid #ccc;
      }
      section.strip li.sevent {
        margin: 2px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      section.strip .stime {
        display: inline-block;
        min-width: 44px;
        font-size: 13px;
        color: #555;
      }
      section.strip .stitle {
        font-size: 13px;
        font-weight: bold;
      }
      footer {
        margin-top: 24px;
        padding-top: 8px;
        border-top: 1px solid #ccc;
        color: #888;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    {
      configError ? (
        <main>
          <h1>Kindle Calendar</h1>
          <p>{configError}</p>
          <p>
            Then set the <code>CALENDARS</code> environment variable on the server (runtime, not build) and restart the container.
          </p>
        </main>
      ) : (
        <main>
          <h1>Next 7 Days — {weekLabel}</h1>
          {
            (() => {
              const hero = days[0];
              return (
                <section>
                  <h2 class={hero.key === todayKey ? 'today' : ''}>{hero.label}{hero.key === todayKey ? ' · Today' : ''}</h2>
                  {
                    hero.events.length === 0 ? (
                      <p class="free">free</p>
                    ) : (
                      <ul>
                        {
                          hero.events.map((ev) => (
                            <li class="event" style={`border-left-color:${ev.shade}`}>
                              {
                                ev.allDay
                                  ? <span class="allday">All day</span>
                                  : hero.key === ev.startKey
                                    ? <span class="time">{timeFmt.format(ev.start)}</span>
                                    : null
                              }
                              <span class="title">{ev.summary}</span>
                              <span class="cal">{ev.calendarName}</span>
                            </li>
                          ))
                        }
                      </ul>
                    )
                  }
                </section>
              );
            })()
          }
          <section class="strip">
            {
              stripRows.map((row) => (
                <div class="dayrow">
                  {
                    row.map((day) => (
                      <div class="daycol">
                        <h2>{day.label}</h2>
                        {
                          day.events.length > 0 && (
                            <ul>
                              {
                                day.events.map((ev) => (
                                  <li class="sevent">
                                    {
                                      ev.allDay ? (
                                        <span class="stitle">{ev.summary}</span>
                                      ) : (
                                        <>
                                          <span class="stime">{timeFmt.format(ev.start)}</span>
                                          <span class="stitle">{ev.summary}</span>
                                        </>
                                      )
                                    }
                                  </li>
                                ))
                              }
                            </ul>
                          )
                        }
                      </div>
                    ))
                  }
                </div>
              ))
            }
          </section>
          <footer>Updated {updatedTimeStr}</footer>
        </main>
      )
    }
  </body>
</html>
